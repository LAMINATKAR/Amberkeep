<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Amberkeep.App</RootNamespace>
    <AssemblyName>Amberkeep</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Generated by tools/Amberkeep.IconGen from LogoArt. -->
    <ApplicationIcon>Assets\amberkeep.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amberkeep.Core\Amberkeep.Core.csproj" />
    <ProjectReference Include="..\Amberkeep.Storage\Amberkeep.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\amberkeep.ico" />
    <!-- Shown by About → View licenses, and shipped next to the exe together with LICENSE. -->
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt;..\..\LICENSE" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Amberkeep.Tests" />
    <InternalsVisibleTo Include="Amberkeep.Screenshots" />
  </ItemGroup>

</Project>
