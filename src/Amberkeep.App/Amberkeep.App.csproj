    <RootNamespace>Amberkeep.App</RootNamespace>
    <AssemblyName>Amberkeep</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amberkeep.Core\Amberkeep.Core.csproj" />
    <ProjectReference Include="..\Amberkeep.Storage\Amberkeep.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Amberkeep.Tests" />
    <InternalsVisibleTo Include="Amberkeep.Screenshots" />
  </ItemGroup>

</Project>
