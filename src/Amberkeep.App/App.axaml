<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Amberkeep.App"
             x:Class="Amberkeep.App.App"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <app:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#D4911F" AltHigh="White" RegionColor="#F7F5F2" />
        <ColorPaletteResources x:Key="Dark" Accent="#E0A030" AltHigh="Black" RegionColor="#1C1B1A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Amberkeep/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
