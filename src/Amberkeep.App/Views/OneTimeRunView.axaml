<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amberkeep.App.ViewModels"
             x:Class="Amberkeep.App.Views.OneTimeRunView"
             x:DataType="vm:OneTimeRunViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,22,28,28" Spacing="16" MaxWidth="860">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="One-time run" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Mirror a folder once without saving a backup. Nothing is stored by Amberkeep: no settings, no history, no marker on the target." />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="muted small" Text="Copy from" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Classes="mono" Text="{Binding SourcePath}" PlaceholderText="Source folder" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseSourceCommand}" />
          </Grid>
          <TextBlock Classes="muted small" Text="Mirror into" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Classes="mono" Text="{Binding TargetPath}" PlaceholderText="Target folder" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseTargetCommand}" />
          </Grid>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="The target becomes an exact copy of the source: files that are not in the source are removed from it. You will see every change before anything happens." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <CheckBox IsChecked="{Binding CompareContent}" Content="Compare file contents (exact, slower)" />
          <CheckBox IsChecked="{Binding ArchiveEnabled}" Content="Keep replaced and removed files in .amberkeep/archive on the target" />
          <TextBlock Classes="muted small" Text="Exclusions (one pattern per line)" />
          <TextBox Classes="mono" Text="{Binding ExclusionsText}" AcceptsReturn="True" Height="110" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Command="{Binding CancelCommand}" />
        <Button Classes="accent" Content="Analyze" Command="{Binding AnalyzeCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
