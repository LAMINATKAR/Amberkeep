<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amberkeep.App.ViewModels"
             x:Class="Amberkeep.App.Views.ConfirmDialogView"
             x:DataType="vm:ConfirmDialogViewModel">
  <UserControl.Styles>
    <Style Selector="Border.dialog"><Setter Property="Width" Value="500" /></Style>
    <!-- Long texts (licenses) get room for 100 monospace characters per line. -->
    <Style Selector="Border.dialog.wide"><Setter Property="Width" Value="800" /></Style>
  </UserControl.Styles>
  <Border Classes="card dialog" Classes.wide="{Binding IsLongText}" Padding="24" BoxShadow="0 12 40 0 #40000000">
    <StackPanel Spacing="14">
      <TextBlock Classes="h2" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding !IsLongText}" />
      <ScrollViewer MaxHeight="440" IsVisible="{Binding IsLongText}">
        <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="12" />
      </ScrollViewer>
      <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding HasOptions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DialogOptionViewModel">
            <CheckBox IsChecked="{Binding IsChecked}">
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
        <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsVisible="{Binding HasCancel}" />
        <Button Classes="accent" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding !IsDestructive}" />
        <Button Classes="danger" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsVisible="{Binding IsDestructive}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
