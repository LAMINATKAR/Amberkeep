<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Amberkeep.App.Views.LogoView"
             Width="40" Height="40">
  <!-- An amber stone: a faceted gem with a small preserved "drop" inside. -->
  <Viewbox>
    <Canvas Width="64" Height="64">
      <Path Data="M20,6 L44,6 L58,24 L32,60 L6,24 Z">
        <Path.Fill>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#F7CF6B" />
            <GradientStop Offset="0.55" Color="#E09A26" />
            <GradientStop Offset="1" Color="#A9600E" />
          </LinearGradientBrush>
        </Path.Fill>
      </Path>
      <Path Data="M6,24 L58,24" Stroke="#FFF1C9" StrokeThickness="1.6" Opacity="0.7" />
      <Path Data="M20,6 L26,24 L32,60 M44,6 L38,24 L32,60" Stroke="#FFF1C9" StrokeThickness="1.2" Opacity="0.45" />
      <Path Data="M20,6 L44,6 L38,24 L26,24 Z" Fill="#FFF3D1" Opacity="0.35" />
      <Ellipse Canvas.Left="28" Canvas.Top="32" Width="8" Height="8" Fill="#5A3307" Opacity="0.75" />
    </Canvas>
  </Viewbox>
</UserControl>
