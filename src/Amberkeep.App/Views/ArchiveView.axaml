<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amberkeep.App.ViewModels"
             x:Class="Amberkeep.App.Views.ArchiveView"
             x:DataType="vm:ArchiveViewModel">
  <DockPanel Margin="28,22,28,20">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
      <Button Classes="subtle" Content="← Back" Command="{Binding BackCommand}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <TextBlock Classes="h1" Text="Archive" />
        <TextBlock Classes="muted" Text="{Binding Title}" />
      </StackPanel>
    </Grid>

    <!-- Restore progress -->
    <Border DockPanel.Dock="Bottom" Classes="card" Padding="16,12" Margin="0,12,0,0" IsVisible="{Binding IsRestoring}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="6">
          <ProgressBar IsIndeterminate="True" Height="6" CornerRadius="3" />
          <TextBlock Classes="small muted" Text="{Binding RestoreStatus}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="1" Content="Stop" Margin="12,0,0,0" Command="{Binding CancelRestoreCommand}" />
      </Grid>
    </Border>

    <Border Classes="card" Padding="40" IsVisible="{Binding IsEmpty}" VerticalAlignment="Top">
      <StackPanel HorizontalAlignment="Center" Spacing="6">
        <TextBlock Classes="h2" Text="The archive is empty" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="Replaced and removed files appear here after a run with the archive switched on." />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="2*,16,3*" IsVisible="{Binding !IsEmpty}">
      <!-- Snapshots -->
      <Border Classes="card" Padding="6">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="10,10,10,6">
            <TextBlock Classes="muted small" Text="{Binding RetentionText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="danger" Content="Delete snapshot" Command="{Binding DeleteSnapshotCommand}" />
              <Button Content="Clean up old" Command="{Binding CleanUpOldCommand}" />
            </StackPanel>
          </StackPanel>
          <ListBox Classes="tree" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SnapshotRowViewModel">
                <StackPanel Spacing="2" Margin="4,6">
                  <TextBlock FontWeight="SemiBold" Text="{Binding When}" />
                  <TextBlock Classes="muted small" Text="{Binding Summary}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Files -->
      <Border Grid.Column="2" Classes="card" Padding="6">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,6,6,8">
            <TextBox PlaceholderText="Search files" Text="{Binding SearchText}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
              <Button Classes="subtle" Content="Select all" Command="{Binding SelectAllCommand}" />
              <Button Classes="subtle" Content="Select none" Command="{Binding SelectNoneCommand}" />
            </StackPanel>
          </Grid>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="10,8,6,6">
            <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Content="Restore to…" Command="{Binding RestoreToFolderCommand}" />
              <Button Classes="accent" Content="Restore to original folder" Command="{Binding RestoreToSourceCommand}" />
            </StackPanel>
          </Grid>
          <ListBox Classes="tree" ItemsSource="{Binding Files}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ArchivedFileRowViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="path" Text="{Binding Path}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Classes="muted small" Text="{Binding SizeText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
