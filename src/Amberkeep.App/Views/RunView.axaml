<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amberkeep.App.ViewModels"
             xmlns:app="using:Amberkeep.App"
             x:Class="Amberkeep.App.Views.RunView"
             x:DataType="vm:RunViewModel">
  <ScrollViewer>
    <StackPanel Margin="28,22,28,28" Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="Backing up" IsVisible="{Binding IsRunning}" />
        <TextBlock Classes="h1" Text="Backup finished" IsVisible="{Binding IsFinished}" />
        <TextBlock Classes="muted" Text="{Binding Title}" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
          <TextBlock Classes="muted small" Text="From" Margin="0,0,12,0" />
          <TextBlock Grid.Column="1" Classes="path" Text="{Binding SourcePath}" />
          <TextBlock Grid.Row="1" Classes="muted small" Text="To" Margin="0,0,12,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="path" Text="{Binding TargetPath}" />
        </Grid>
      </StackPanel>

      <!-- Running -->
      <Border Classes="card" IsVisible="{Binding IsRunning}">
        <StackPanel Spacing="10">
          <ProgressBar Height="8" CornerRadius="4" Minimum="0" Maximum="100"
                       Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontWeight="SemiBold" Text="{Binding OperationText}" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding CountText}" />
          </Grid>
          <TextBlock Classes="path" Text="{Binding CurrentPath}" />
          <TextBlock Classes="muted small" Text="{Binding SpeedText}" />
          <Button Content="Stop" Command="{Binding CancelCommand}" HorizontalAlignment="Right" />
        </StackPanel>
      </Border>

      <!-- Finished -->
      <Border Classes="card" IsVisible="{Binding IsFinished}">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                     Fill="{Binding OutcomeKind, Converter={x:Static app:Converters.OutcomeBrush}}" />
            <TextBlock Classes="h2" Text="{Binding OutcomeText}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatViewModel">
                <Border Classes="row" Margin="0,0,8,8" MinWidth="150">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="muted small" Text="{Binding Label}" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding Value}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="4" IsVisible="{Binding Problems.Count}">
            <TextBlock Classes="section" Text="Problems" Foreground="{x:Static app:Converters.Red}" Margin="0" />
            <ItemsControl ItemsSource="{Binding Problems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="small" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding Notes.Count}">
            <TextBlock Classes="section" Text="Notes" Margin="0" />
            <ItemsControl ItemsSource="{Binding Notes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="small muted" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Open archive" Command="{Binding OpenArchiveCommand}" IsVisible="{Binding HasArchive}" />
            <Button Content="Save report…" Command="{Binding SaveReportCommand}" IsVisible="{Binding CanSaveReport}" />
            <Button Classes="accent" Content="Done" Command="{Binding DoneCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
