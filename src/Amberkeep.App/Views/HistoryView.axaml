<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amberkeep.App.ViewModels"
             xmlns:history="using:Amberkeep.Storage.History"
             xmlns:app="using:Amberkeep.App"
             x:Class="Amberkeep.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <DockPanel Margin="28,22,28,20">
    <!-- Header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
      <Button Classes="subtle" Content="← Back" Command="{Binding BackCommand}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="h1" Text="History" Margin="12,0,0,0" VerticalAlignment="Center" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" MinWidth="220">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:JobFilter">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <Border Classes="card" Padding="40" IsVisible="{Binding IsEmpty}" VerticalAlignment="Top">
      <StackPanel HorizontalAlignment="Center" Spacing="6">
        <TextBlock Classes="h2" Text="No runs yet" HorizontalAlignment="Center" />
        <TextBlock Classes="muted" Text="Every backup run is recorded here, including runs that were stopped or refused." />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="5*,16,6*" IsVisible="{Binding !IsEmpty}">
      <!-- Runs -->
      <Border Classes="card" Padding="6">
        <ListBox Classes="tree" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,6">
                <Ellipse Width="10" Height="10" Margin="0,4,12,0" VerticalAlignment="Top"
                         Fill="{Binding OutcomeKind, Converter={x:Static app:Converters.OutcomeBrush}}" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <!-- The chip keeps its place; a long title is trimmed before it. -->
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsDeleted}"
                            ToolTip.Tip="This backup has been deleted. Its runs stay here until the history limit removes them.">
                      <TextBlock Text="Deleted" />
                    </Border>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Classes="muted small" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="2" Margin="12,0,14,0">
                  <TextBlock Classes="small" Text="{Binding When}" HorizontalAlignment="Right" />
                  <TextBlock Classes="muted small" Text="{Binding Duration}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- Detail -->
      <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasSelection}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <!-- Centered against the (taller) buttons next to it. -->
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                         Fill="{Binding SelectedRun.OutcomeKind, Converter={x:Static app:Converters.OutcomeBrush}, FallbackValue={x:Null}}" />
                <TextBlock Classes="h2" Text="{Binding SelectedRun.OutcomeText, FallbackValue=''}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Open archive" Command="{Binding OpenArchiveCommand}" />
                <Button Content="Export report…" Command="{Binding ExportReportCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="muted" Text="{Binding SelectedRun.Title, FallbackValue=''}" />
            <TextBlock Classes="path" Text="{Binding SelectedRun.Record.SourcePath, FallbackValue=''}" />
            <TextBlock Classes="path" Text="{Binding SelectedRun.Record.TargetPath, FallbackValue=''}" />

            <ItemsControl ItemsSource="{Binding Stats}" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StatViewModel">
                  <Border Classes="row" Margin="0,0,8,8" MinWidth="120" Padding="10,6">
                    <StackPanel Spacing="1">
                      <TextBlock Classes="muted small" Text="{Binding Label}" />
                      <TextBlock FontWeight="SemiBold" Text="{Binding Value}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Problems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="small" Text="{Binding}" TextWrapping="Wrap" Foreground="{x:Static app:Converters.Red}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Notes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="small muted" Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="section" Text="Changes" Margin="0,6,0,0" />
            <TextBlock Classes="muted small" Text="{Binding ChangesNote}"
                       IsVisible="{Binding ChangesNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>

          <ListBox Classes="tree" ItemsSource="{Binding Changes}" Background="Transparent" Margin="0,6,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="history:RecordedChange">
                <Grid ColumnDefinitions="16,*,Auto">
                  <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Fill="{Binding Category, Converter={x:Static app:Converters.CategoryBrush}}" />
                  <TextBlock Grid.Column="1" Classes="path" Text="{Binding Path}" VerticalAlignment="Center" />
                  <!-- Right margin: the scrollbar widens over the row when it is used. -->
                  <TextBlock Grid.Column="2" Classes="small" Margin="12,0,18,0" VerticalAlignment="Center"
                             Text="{Binding Category, Converter={x:Static app:Converters.CategoryText}}"
                             Foreground="{Binding Category, Converter={x:Static app:Converters.CategoryBrush}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
