<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Amberkeep.App.ViewModels"
             xmlns:views="using:Amberkeep.App.Views"
             x:Class="Amberkeep.App.Views.BusyView"
             x:DataType="vm:BusyViewModel">
  <Border Classes="card" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
    <StackPanel Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <views:LogoView Width="32" Height="32" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Classes="h2" Text="{Binding Title}" />
          <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
      <ProgressBar IsIndeterminate="True" Height="6" CornerRadius="3" />
      <TextBlock Classes="muted small" Text="{Binding Status}" TextWrapping="Wrap" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</UserControl>
