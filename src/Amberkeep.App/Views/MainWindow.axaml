<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Amberkeep.App.ViewModels"
        x:Class="Amberkeep.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Amberkeep"
        Icon="avares://Amberkeep/Assets/amberkeep.ico"
        Width="1120" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}">
  <Grid>
    <ContentControl Content="{Binding CurrentPage}" />

    <Border Background="{DynamicResource OverlayBrush}"
            IsVisible="{Binding Dialog, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
